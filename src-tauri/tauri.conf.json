{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Consola de liquidación",
  "version": "0.1.0",
  "identifier": "es.uah.aula.liquidacion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Consola de liquidación",
        "width": 1100,
        "height": 730,
        "minWidth": 690,
        "minHeight": 510
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
